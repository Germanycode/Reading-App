# Copy this to .env.production on your deployment machine and edit the values.
#
# For a public domain:
# PUBLIC_APP_URL=https://read.example.com
# NEXT_PUBLIC_API_BASE_URL=https://api.read.example.com/api
# CORS_ORIGINS=https://read.example.com
#
# For one host with exposed ports:
# PUBLIC_APP_URL=http://YOUR_SERVER_IP:3000
# NEXT_PUBLIC_API_BASE_URL=http://YOUR_SERVER_IP:8000/api
# CORS_ORIGINS=http://YOUR_SERVER_IP:3000

PUBLIC_APP_URL=http://YOUR_SERVER_IP:3000
NEXT_PUBLIC_API_BASE_URL=http://YOUR_SERVER_IP:8000/api
CORS_ORIGINS=http://YOUR_SERVER_IP:3000

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_SUMMARY_MODEL=gemini-2.5-flash
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_QUICK_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
OPENROUTER_CHAT_MODEL=openrouter/free
OPENROUTER_APP_NAME=AI Reading App

CHROMA_PERSIST_DIR=/app/data/chroma
UPLOAD_DIR=/app/data/uploads
AUDIOBOOKS_DIR=/app/data/audiobooks
ASSETS_BOOKS_DIR=/assets/books
ASSETS_MUSICS_DIR=/assets/musics
ASSETS_ICONS_DIR=/assets/icons
DATABASE_URL=sqlite+aiosqlite:////app/data/db.sqlite
